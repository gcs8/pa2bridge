#!/usr/bin/with-contenv bashio

if ! bashio::services.available mqtt; then
    bashio::exit.nok "The Home Assistant MQTT service is unavailable"
fi

export PA2BRIDGE_MQTT_HOST="$(bashio::services mqtt 'host')"
export PA2BRIDGE_MQTT_PORT="$(bashio::services mqtt 'port')"
export PA2BRIDGE_MQTT_USERNAME="$(bashio::services mqtt 'username')"
export PA2BRIDGE_MQTT_PASSWORD="$(bashio::services mqtt 'password')"

bashio::log.info "Starting PA2Bridge with Home Assistant MQTT discovery"
exec /opt/pa2bridge/bin/python -m pa2bridge.ha_app --options /data/options.json
